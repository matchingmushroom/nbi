rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — own write only; any authenticated user can read (needed for leaderboard, contest eligibility)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Results — any authenticated user can read (leaderboard needs all results); create restricted to own
    match /results/{resultId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Notifications — own notifications only
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Contests — any authenticated user can read (leaderboard needs all completed contests); only organizer can update/delete
    match /contests/{contestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.organizerId == request.auth.uid;
    }

    // Questions — any authenticated user (needed for quizzes)
    match /questions/{questionId} {
      allow read, write: if request.auth != null;
    }

    // Courses / micro_learning — any authenticated user
    match /courses/{courseId} {
      allow read, write: if request.auth != null;
    }
    match /micro_learning/{dayId} {
      allow read, write: if request.auth != null;
    }

    // Quiz settings — any authenticated user (stored at config/quizSettings)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Badges — any authenticated user
    match /badges/{badgeId} {
      allow read: if request.auth != null;
    }

    // Streaks — any authenticated user
    match /streaks/{streakId} {
      allow read: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
