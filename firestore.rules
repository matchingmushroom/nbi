rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — own doc only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Results — own results only
    match /results/{resultId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Notifications — own notifications only
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Contests — participant or organizer only
    match /contests/{contestId} {
      allow read: if request.auth != null && (
        resource.data.organizerId == request.auth.uid ||
        resource.data.participants[request.auth.uid] != null
      );
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.organizerId == request.auth.uid;
    }

    // Questions — any authenticated user (needed for quizzes)
    match /questions/{questionId} {
      allow read: if request.auth != null;
    }

    // Courses / micro_learning — any authenticated user
    match /courses/{courseId} {
      allow read: if request.auth != null;
    }
    match /micro_learning/{dayId} {
      allow read: if request.auth != null;
    }

    // Quiz settings — any authenticated user
    match /quizSettings/{settingId} {
      allow read: if request.auth != null;
    }

    // Badges — any authenticated user
    match /badges/{badgeId} {
      allow read: if request.auth != null;
    }

    // Streaks — any authenticated user
    match /streaks/{streakId} {
      allow read: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
